# --- Supabase (Paramètres du projet → API) ---
# URL et clé publique : exposées au navigateur, protégées par la RLS.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète service_role : UNIQUEMENT côté serveur (Vercel → Environment
# Variables, sans préfixe NEXT_PUBLIC_). Sert à créer les comptes employés et à
# limiter les tentatives de connexion. Ne jamais la committer.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application (liens, métadonnées)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Facultatif : clé stable de chiffrement des Server Actions si plusieurs
# instances auto-hébergées (inutile sur Vercel).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

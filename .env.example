# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL publique canonique (SEO, sitemap). Par défaut : https://atelier-pro-rose.vercel.app
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bictorys — https://docs.bictorys.com/docs/integration
# Sandbox: https://api.test.bictorys.com / Production: https://api.bictorys.com
BICTORYS_API_URL=https://api.test.bictorys.com
BICTORYS_API_KEY=
BICTORYS_WEBHOOK_SECRET=

# Chariow — https://chariow.dev (remplace Bictorys quand PAYMENT_PROVIDER=chariow)
# Laisser vide / "bictorys" tant qu'un achat test réel n'a pas confirmé Wave/Orange Money côté Chariow.
PAYMENT_PROVIDER=bictorys
NEXT_PUBLIC_PAYMENT_PROVIDER=bictorys
CHARIOW_API_KEY=
# Secret du Pulse (whsec_...), PAS la clé API. URL du Pulse : https://<domaine>/api/webhooks/chariow
CHARIOW_PULSE_SECRET=
# Relier chaque plan à son produit Chariow :
#   update plans set chariow_product_id = 'prd_...' where slug = 'starter';
